# =========================
# AniKot 2.0.0 / BotHost.ru
# =========================

# VK community
VK_TOKEN=vk1.a.your_group_token
VK_GROUP_ID=123456789
VK_GROUP_URL=https://vk.com/club123456789
ADMIN_IDS=123456789

# Legal documents shown before first registration
USER_AGREEMENT_URL=https://example.com/user-agreement
PRIVACY_POLICY_URL=https://example.com/privacy

# Stable referral base. Numeric club ID is recommended because it survives renames.
VK_REFERRAL_BASE_URL=https://vk.me/club123456789

# Registration / subscription / referral bonuses
# Registration: +1 regular AniKot
# Community subscription: +2 regular AniKot
# Referral after 3-day hold: +3 AniKot Pro
REGISTRATION_BONUS_REQUESTS=1
SUBSCRIPTION_BONUS_REQUESTS=2
REFERRAL_REWARD_PRO=3
REFERRAL_FREEZE_DAYS=3

# 3 unsubscribe strikes => account block
UNSUBSCRIBE_STRIKE_LIMIT=3

# Community activity => regular AniKot requests
ACTIVITY_ACTIONS_PER_REWARD=3
ACTIVITY_REWARD_REQUESTS=1
ACTIVITY_DAILY_REWARD_CAP=3
ACTIVITY_COOLDOWN_SECONDS=60
ACTIVITY_MIN_TEXT_LENGTH=12

# Public BotHost URL used for browser checkout
PUBLIC_BASE_URL=https://anikot.bothost.tech

# BotHost persistent storage
DATA_DIR=/app/data
DATABASE_PATH=/app/data/bot.sqlite3
TEMP_DIR=/app/data/tmp

# Search models through AIAI.BY
AIAI_API_KEY=sk-your-key
AIAI_BASE_URL=https://api.aiai.by/v1
AIAI_ANIKOT_MODEL=gemini-3.1-flash-lite
AIAI_PRO_MODEL=gemini-3.5-flash
AIAI_PROPLUS_MODEL=gemini-3.1-pro
AIAI_TIMEOUT=90
AIAI_MAX_CONCURRENCY=3

# AniKot 2.0 low-memory mode
LOW_MEMORY_MODE=true
VK_IMAGE_MAX_SIDE=1280
IMAGE_MAX_BYTES=6291456
HTTP_MAX_CONNECTIONS=8
HTTP_MAX_KEEPALIVE_CONNECTIONS=4
HTTP_KEEPALIVE_EXPIRY=20
DB_CACHE_KIB=1024

# Minimum accepted model confidence
ANIKOT_MIN_CONFIDENCE=0.70
PRO_MIN_CONFIDENCE=0.80
PROPLUS_MIN_CONFIDENCE=0.90
PROPLUS_REQUIRE_AGE_CONFIRMATION=true

# lava.top payment settings
LAVA_API_KEY=your_lava_api_key
LAVA_WEBHOOK_KEY=your_webhook_secret
LAVA_OFFER_ID=your_current_dynamic_offer_id
LAVA_PRODUCT_TITLE=Пополнение запросов
LAVA_BASE_URL=https://gate.lava.top
LAVA_CURRENCY=RUB
LAVA_SUCCESS_URL=
LAVA_FAILURE_URL=
LAVA_CANCEL_URL=

# Optional custom packages JSON. Defaults:
# AniKot: 50/59 RUB, 150/129 RUB
# Pro: 10/79, 30/199, 100/599
# Pro+: 10/119, 30/299, 100/849
# SEARCH_PACKAGES_JSON=

# BotHost supplies PORT automatically. Keep panel port at 3000.
WEB_HOST=0.0.0.0
# WEB_PORT=8080
